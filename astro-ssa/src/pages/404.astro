---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page introuvable — SSA" description="La page demandée n'existe pas ou a été déplacée.">
  <main class="section error-404">
    <div class="section-inner" style="text-align:center; max-width:640px;">
      <span class="section-kicker">Erreur 404</span>
      <h1 class="section-title section-title--big" data-fr="Page introuvable" data-en="Page not found">Page introuvable</h1>
      <p class="section-subtitle" style="margin:10px auto 0;"
         data-fr="La page que vous cherchez n'existe pas ou a été déplacée."
         data-en="The page you are looking for doesn't exist or has moved.">La page que vous cherchez n'existe pas ou a été déplacée.</p>
      <div style="margin-top:30px; display:flex; gap:12px; justify-content:center; flex-wrap:wrap;">
        <a href="/" class="btn btn-primary btn-lg" data-i18n="home">Accueil</a>
        <a href="/catalogue/" class="btn btn-outline btn-lg" data-i18n="catalogue">Catalogue</a>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .error-404 { padding: 90px 24px; }
</style>
