# SSA — règles serveur Apache (IONOS)

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) www.ssa.green → ssa.green (domaine canonique, 301)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # 2) Anciennes URL Odoo → nouvelles pages
  RewriteRule ^accueil/?$ / [R=301,L]
  RewriteRule ^home/?$ / [R=301,L]
</IfModule>

# Page 404 personnalisée (générée par Astro)
ErrorDocument 404 /404.html
