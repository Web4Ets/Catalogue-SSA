# Identifiants FTP IONOS — copiez ce fichier en `.env` et renseignez vos valeurs.
# `.env` est git-ignoré : vos identifiants ne sont jamais commités.
# Récupérables dans IONOS → Hébergement → Accès FTP/SFTP.
FTP_HOST=accessXXXXXXXX.webspace-host.com
FTP_USER=uXXXXXXXX
FTP_PASSWORD=
# Dossier racine web sur IONOS (souvent "/" ; parfois "/htdocs" ou un sous-dossier)
FTP_REMOTE_DIR=/
# true pour du FTPS explicite (recommandé si supporté par votre offre)
FTP_SECURE=false
